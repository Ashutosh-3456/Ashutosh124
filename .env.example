# Add these as Environment Variables in Render (do not commit real secrets)
PORT=10000
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=
SARVAM_OCR_MODEL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# MongoDB Atlas (required for persistent application data)
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/aayuvora?retryWrites=true&w=majority
MONGODB_DB_NAME=aayuvora
